# URL del endpoint local de Ollama para generar texto.
OLLAMA_URL=http://localhost:11434/api/generate
# Modelo local que Ollama debe usar para el review.
OLLAMA_MODEL=mistral
# Token personal con permisos para crear issues en GitHub.
GITHUB_TOKEN=your_github_token_here
# Repositorio destino en formato owner/repo.
GITHUB_REPO=your-username/frontend-mentor-agent
